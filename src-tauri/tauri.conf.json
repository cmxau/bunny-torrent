{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bunny Torrent",
  "version": "0.1.0",
  "identifier": "dev.bunny.torrent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bunny Torrent",
        "width": 1120,
        "height": 660,
        "minWidth": 900,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RjNENDJEMEYxRkQ3OEUKUldTTzF4OFBMZFR6aFNwMmZnYi9hcmdXYklLQWRpSERjaWFhRlpFcUZaODVhWXJGRGk0dFY5bnIK",
      "endpoints": [
        "https://github.com/cmxau/bunny-torrent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
